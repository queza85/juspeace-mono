generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Datetime policy: all DateTime columns use TIMESTAMPTZ and are stored as UTC.
// Clients convert to the viewer's local zone (e.g. Asia/Seoul, Asia/Yangon) for display only.

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum UserRole {
  USER
  ADMIN
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  passwordHash  String
  role          UserRole       @default(USER)
  name          String?
  isActive      Boolean        @default(true)
  refreshTokens RefreshToken[]
  createdAt     DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime       @updatedAt @db.Timestamptz(3)

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  familyId  String
  expiresAt DateTime  @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)
  userAgent String?
  ipAddress String?
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

model Category {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  description String?
  products    Product[]
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)

  @@map("categories")
}

model Product {
  id          String        @id @default(cuid())
  slug        String        @unique
  name        String
  description String?
  priceCents  Int
  currency    String        @default("USD")
  stock       Int           @default(0)
  status      ProductStatus @default(DRAFT)
  imageUrl    String?
  categoryId  String?
  category    Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdAt   DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @db.Timestamptz(3)

  @@index([status])
  @@index([categoryId])
  @@map("products")
}
