generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Datetime policy: all DateTime columns use TIMESTAMPTZ and are stored as UTC.
// Clients convert to the viewer's local zone (e.g. Asia/Seoul, Asia/Yangon) for display only.

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum UserRole {
  USER
  ADMIN
}

enum OAuthProvider {
  GOOGLE
}

model User {
  id                     String                 @id @default(cuid())
  email                  String                 @unique
  passwordHash           String?
  role                   UserRole               @default(USER)
  name                   String?
  isActive               Boolean                @default(true)
  twoFactorEnabled       Boolean                @default(false)
  refreshTokens          RefreshToken[]
  oauthAccounts          OAuthAccount[]
  passwordResetCodes     PasswordResetCode[]
  passwordResetSessions  PasswordResetSession[]
  twoFactorChallenges    TwoFactorChallenge[]
  twoFactorCodes         TwoFactorCode[]
  createdAt              DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime               @updatedAt @db.Timestamptz(3)

  @@map("users")
}

model PasswordResetCode {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash     String
  expiresAt    DateTime  @db.Timestamptz(3)
  consumedAt   DateTime? @db.Timestamptz(3)
  attemptCount Int       @default(0)
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)

  @@index([userId, consumedAt, expiresAt])
  @@map("password_reset_codes")
}

model PasswordResetSession {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  expiresAt  DateTime  @db.Timestamptz(3)
  consumedAt DateTime? @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)

  @@index([userId, consumedAt, expiresAt])
  @@map("password_reset_sessions")
}

model TwoFactorChallenge {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  rememberMe Boolean   @default(false)
  userAgent  String?
  ipAddress  String?
  expiresAt  DateTime  @db.Timestamptz(3)
  consumedAt DateTime? @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)

  @@index([userId, consumedAt, expiresAt])
  @@map("two_factor_challenges")
}

model TwoFactorCode {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash     String
  expiresAt    DateTime  @db.Timestamptz(3)
  consumedAt   DateTime? @db.Timestamptz(3)
  attemptCount Int       @default(0)
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)

  @@index([userId, consumedAt, expiresAt])
  @@map("two_factor_codes")
}

model OAuthAccount {
  id             String        @id @default(cuid())
  provider       OAuthProvider
  providerUserId String
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @db.Timestamptz(3)

  @@unique([provider, providerUserId])
  @@index([userId])
  @@map("oauth_accounts")
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  familyId  String
  expiresAt DateTime  @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)
  userAgent String?
  ipAddress String?
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

model Category {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  description String?
  products    Product[]
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)

  @@map("categories")
}

model Product {
  id          String        @id @default(cuid())
  slug        String        @unique
  name        String
  description String?
  priceCents  Int
  currency    String        @default("USD")
  stock       Int           @default(0)
  status      ProductStatus @default(DRAFT)
  imageUrl    String?
  categoryId  String?
  category    Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdAt   DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @db.Timestamptz(3)

  @@index([status])
  @@index([categoryId])
  @@map("products")
}
