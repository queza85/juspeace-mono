NODE_ENV=development
PORT=7777

# PostgreSQL (discrete vars — Nest builds DATABASE_URL for Prisma)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=root
DB_DATABASE=juspeace_develop

# Optional override for Docker / CI. If set, takes precedence over DB_*.
# Local Prisma CLI also uses this when present:
DATABASE_URL=postgresql://postgres:root@127.0.0.1:5432/juspeace_develop?schema=public

# Comma-separated allowed browser origins
CORS_ORIGINS=http://localhost:3000
