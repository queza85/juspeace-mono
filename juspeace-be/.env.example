NODE_ENV=development
PORT=7777

# PostgreSQL (discrete vars — Nest builds DATABASE_URL for Prisma)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=root
DB_DATABASE=juspeace_develop

# Optional override for Docker / CI. If set, takes precedence over DB_*.
# Local Prisma CLI also uses this when present:
DATABASE_URL=postgresql://postgres:root@127.0.0.1:5432/juspeace_develop?schema=public

# Comma-separated allowed browser origins
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Auth (required) — use a long random secret in every environment
JWT_ACCESS_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
REFRESH_TOKEN_SESSION_TTL_DAYS=1
REFRESH_TOKEN_REMEMBER_TTL_DAYS=5
AUTH_COOKIE_NAME=juspeace_refresh
AUTH_COOKIE_SECURE=false

# Google OAuth (optional locally — leave empty to disable Google login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:7777/api/v1/auth/google/callback
OAUTH_SUCCESS_REDIRECT_URL=http://localhost:3000/auth/callback
OAUTH_FAILURE_REDIRECT_URL=http://localhost:3000/login?error=oauth

# Seed accounts (used by prisma/seed.ts only)
SEED_ADMIN_EMAIL=admin@lomtech.net
SEED_ADMIN_PASSWORD=Test!1234
SEED_USER_EMAIL=user@lomtech.net
SEED_USER_PASSWORD=Test!1234

# Transactional email (Nodemailer / SMTP — Mailpit locally)
MAIL_FROM="Juspeace Admin <noreply@juspeace.local>"
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
PASSWORD_RESET_CODE_TTL_MINUTES=10
PASSWORD_RESET_TOKEN_TTL_MINUTES=15
TWO_FACTOR_CODE_TTL_MINUTES=10
TWO_FACTOR_CHALLENGE_TTL_MINUTES=15
# Local QA only — enables POST /auth/two-factor/challenge/dev
TWO_FACTOR_DEV_CHALLENGE=false
