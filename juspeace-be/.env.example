NODE_ENV=development
PORT=7777

# PostgreSQL (discrete vars — Nest builds DATABASE_URL for Prisma)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=root
DB_DATABASE=juspeace_develop

# Optional override for Docker / CI. If set, takes precedence over DB_*.
# Local Prisma CLI also uses this when present:
DATABASE_URL=postgresql://postgres:root@127.0.0.1:5432/juspeace_develop?schema=public

# Comma-separated allowed browser origins
CORS_ORIGINS=http://localhost:3000

# Auth (required) — use a long random secret in every environment
JWT_ACCESS_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
AUTH_COOKIE_NAME=juspeace_refresh
AUTH_COOKIE_SECURE=false

# Seed accounts (used by prisma/seed.ts only)
SEED_ADMIN_EMAIL=admin@lomtech.net
SEED_ADMIN_PASSWORD=Test!1234
SEED_USER_EMAIL=user@lomtech.net
SEED_USER_PASSWORD=Test!1234
