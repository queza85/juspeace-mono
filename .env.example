# Root Docker Compose — copy to `.env` and adjust as needed.
# Used for Compose interpolation only (published host ports + optional build/URL overrides).
# App runtime config lives in each package: juspeace-be/.env, juspeace-fe/.env.local,
# juspeace-admin-fe/.env.local (loaded via service env_file).
# Jenkins/Vault can generate the same keys into `.env` at deploy time.

# Published host ports (container listen ports stay 3000 / 3001 / 7777 / 5432 / 1025 / 8025)
FE_PORT=3000
ADMIN_FE_PORT=3001
BE_PORT=7777
POSTGRES_PORT=5432
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# Optional URL / auth overrides for production (real domains, not localhost).
# Leave unset locally so FE build-args derive NEXT_PUBLIC_API_URL from BE_PORT.
# App secrets (JWT, CORS, mail) prefer package env files; set here only when
# package .env files are absent (e.g. CI injects a single root .env for build-args).
# NEXT_PUBLIC_API_URL=http://localhost:7777/api/v1
# CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# JWT_ACCESS_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
